{
  "name": "opencode-go-usage-meter",
  "version": "0.1.3",
  "description": "OpenCode Go subscription usage bars (rolling, weekly, monthly) in the OpenCode v2 TUI sidebar.",
  "author": "PentSec",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.js"
  },
  "files": [
    "index.ts",
    "tui.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-tui.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "bun test --preload @opentui/solid/preload tests"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-go",
    "opencode-tui",
    "usage",
    "quota",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PentSec/opencode-go-usage-meter.git"
  },
  "bugs": {
    "url": "https://github.com/PentSec/opencode-go-usage-meter/issues"
  },
  "homepage": "https://github.com/PentSec/opencode-go-usage-meter#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opentui/solid": "0.6.6",
    "@types/bun": "1.4.4",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  }
}
